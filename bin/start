#!/usr/bin/env ruby
require 'fileutils'

# Path to the application root.
APP_ROOT = File.expand_path('..', __dir__)

# We want to guard against failures at each stage of this
def system!(*args)
  system(*args) || abort("\n== Command #{args} failed ==")
end

FileUtils.chdir APP_ROOT do
  system! 'git fetch'
  system! 'git checkout main'
  system! 'git reset --hard origin/main'

  system! "bundle config set deployment 'true'"
  system! "bundle config set without 'development test'"
  system! "bundle check || bundle install"
end

require "bundler/setup"
$LOAD_PATH.unshift File.expand_path("../../lib", __FILE__)

require "tooling_manager"

puts "Starting Tooling Manager"
STDOUT.flush
repos = ToolingManager::Manage.()

if Dir.exist?("/home/exercism")
  ready_file = "/home/exercism/.tooling-manager-ready"

  # Only on the machine's first pass, so the invoker starts once the
  # test runners have each run once. See WarmUpTestRunners for why.
  ToolingManager::WarmUpTestRunners.(repos) unless File.exist?(ready_file)

  File.write(ready_file, "Let's gooooooo!")
end
